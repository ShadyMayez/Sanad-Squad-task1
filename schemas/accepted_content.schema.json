{
  "$defs": {
    "AcceptedRecord": {
      "properties": {
        "atomic_claims": {
          "items": {
            "items": {
              "$ref": "#/$defs/AtomicClaim"
            },
            "type": "array"
          },
          "title": "Atomic Claims",
          "type": "array"
        },
        "completion_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completion Tokens"
        },
        "drafts": {
          "items": {
            "$ref": "#/$defs/Draft"
          },
          "title": "Drafts",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "image_spec_reference": {
          "title": "Image Spec Reference",
          "type": "string"
        },
        "prompt_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Tokens"
        },
        "provenance_errors": {
          "items": {
            "type": "string"
          },
          "title": "Provenance Errors",
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "reviews": {
          "items": {
            "$ref": "#/$defs/Review"
          },
          "title": "Reviews",
          "type": "array"
        },
        "semantic_reports": {
          "items": {
            "$ref": "#/$defs/SemanticReport"
          },
          "title": "Semantic Reports",
          "type": "array"
        },
        "slot": {
          "$ref": "#/$defs/Slot"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "status": {
          "const": "accepted",
          "title": "Status",
          "type": "string"
        },
        "topic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topic"
        },
        "usage_measurements_complete": {
          "default": true,
          "title": "Usage Measurements Complete",
          "type": "boolean"
        },
        "validations": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Validations",
          "type": "array"
        },
        "verification_latencies_seconds": {
          "items": {
            "type": "number"
          },
          "title": "Verification Latencies Seconds",
          "type": "array"
        },
        "visual_spec": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visual Spec"
        }
      },
      "required": [
        "slot",
        "status",
        "image_spec_reference"
      ],
      "title": "AcceptedRecord",
      "type": "object"
    },
    "AtomicClaim": {
      "properties": {
        "candidate_evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Candidate Evidence Ids",
          "type": "array"
        },
        "claim_type": {
          "default": "factual",
          "enum": [
            "factual",
            "uncertain"
          ],
          "title": "Claim Type",
          "type": "string"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "proposition": {
          "minLength": 1,
          "title": "Proposition",
          "type": "string"
        },
        "qualifiers": {
          "items": {
            "type": "string"
          },
          "title": "Qualifiers",
          "type": "array"
        },
        "sentence": {
          "minLength": 1,
          "title": "Sentence",
          "type": "string"
        },
        "span": {
          "minLength": 1,
          "title": "Span",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "tweet_index": {
          "minimum": 0,
          "title": "Tweet Index",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "tweet_index",
        "start",
        "end",
        "span",
        "proposition",
        "sentence",
        "candidate_evidence_ids"
      ],
      "title": "AtomicClaim",
      "type": "object"
    },
    "Claim": {
      "properties": {
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "text": {
          "minLength": 5,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "evidence_ids"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClaimSupport": {
      "properties": {
        "claim_text": {
          "title": "Claim Text",
          "type": "string"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_quote": {
          "title": "Evidence Quote",
          "type": "string"
        },
        "supported": {
          "title": "Supported",
          "type": "boolean"
        }
      },
      "required": [
        "claim_text",
        "evidence_id",
        "evidence_quote",
        "supported"
      ],
      "title": "ClaimSupport",
      "type": "object"
    },
    "Draft": {
      "properties": {
        "claims": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Claims",
          "type": "array"
        },
        "tweets": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Tweets",
          "type": "array"
        }
      },
      "required": [
        "tweets"
      ],
      "title": "Draft",
      "type": "object"
    },
    "Evidence": {
      "properties": {
        "excerpt": {
          "minLength": 12,
          "title": "Excerpt",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "quote_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote End"
        },
        "quote_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote Start"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope"
        },
        "snapshot_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot Path"
        },
        "snapshot_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot Sha256"
        },
        "source_quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Quote"
        },
        "source_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Title"
        },
        "source_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Type"
        },
        "url": {
          "pattern": "^https://[^\\s]+$",
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "id",
        "url",
        "excerpt"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceContext": {
      "properties": {
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "snapshot_sha256": {
          "title": "Snapshot Sha256",
          "type": "string"
        },
        "source_scope": {
          "default": "",
          "title": "Source Scope",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "text": {
          "minLength": 8,
          "title": "Text",
          "type": "string"
        },
        "token_budget_upper_bound": {
          "default": 1400,
          "exclusiveMinimum": 0,
          "title": "Token Budget Upper Bound",
          "type": "integer"
        },
        "token_upper_bound": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Upper Bound"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        },
        "window_partial": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window Partial"
        }
      },
      "required": [
        "evidence_id",
        "snapshot_sha256",
        "start",
        "end",
        "text"
      ],
      "title": "EvidenceContext",
      "type": "object"
    },
    "Review": {
      "properties": {
        "approved": {
          "title": "Approved",
          "type": "boolean"
        },
        "brand_voice": {
          "maximum": 5,
          "minimum": 0,
          "title": "Brand Voice",
          "type": "integer"
        },
        "claim_support": {
          "items": {
            "$ref": "#/$defs/ClaimSupport"
          },
          "title": "Claim Support",
          "type": "array"
        },
        "clarity": {
          "maximum": 5,
          "minimum": 0,
          "title": "Clarity",
          "type": "integer"
        },
        "corrections": {
          "items": {
            "type": "string"
          },
          "title": "Corrections",
          "type": "array"
        },
        "factual_support": {
          "maximum": 5,
          "minimum": 0,
          "title": "Factual Support",
          "type": "integer"
        },
        "grounding_assessment": {
          "title": "Grounding Assessment",
          "type": "string"
        },
        "platform_format": {
          "maximum": 5,
          "minimum": 0,
          "title": "Platform Format",
          "type": "integer"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "technical_correctness": {
          "maximum": 5,
          "minimum": 0,
          "title": "Technical Correctness",
          "type": "integer"
        },
        "usefulness": {
          "maximum": 5,
          "minimum": 0,
          "title": "Usefulness",
          "type": "integer"
        }
      },
      "required": [
        "factual_support",
        "technical_correctness",
        "brand_voice",
        "clarity",
        "platform_format",
        "usefulness",
        "approved",
        "grounding_assessment"
      ],
      "title": "Review",
      "type": "object"
    },
    "SemanticReport": {
      "properties": {
        "verdicts": {
          "items": {
            "$ref": "#/$defs/SemanticVerdict"
          },
          "title": "Verdicts",
          "type": "array"
        }
      },
      "required": [
        "verdicts"
      ],
      "title": "SemanticReport",
      "type": "object"
    },
    "SemanticVerdict": {
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "context_windows": {
          "items": {
            "$ref": "#/$defs/EvidenceContext"
          },
          "title": "Context Windows",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "initial_pass": {
          "anyOf": [
            {
              "$ref": "#/$defs/VerificationPass"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "missing_information": {
          "default": "",
          "title": "Missing Information",
          "type": "string"
        },
        "proposed_supporting_spans": {
          "items": {
            "$ref": "#/$defs/SupportingSpan"
          },
          "title": "Proposed Supporting Spans",
          "type": "array"
        },
        "reason": {
          "minLength": 8,
          "title": "Reason",
          "type": "string"
        },
        "scope_mismatch": {
          "default": "",
          "title": "Scope Mismatch",
          "type": "string"
        },
        "skeptical_pass": {
          "anyOf": [
            {
              "$ref": "#/$defs/VerificationPass"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "supporting_span_ids": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Span Ids",
          "type": "array"
        },
        "supporting_spans": {
          "items": {
            "$ref": "#/$defs/SupportingSpan"
          },
          "title": "Supporting Spans",
          "type": "array"
        },
        "verdict": {
          "enum": [
            "SUPPORTED",
            "CONTRADICTED",
            "INSUFFICIENT_EVIDENCE",
            "AMBIGUOUS",
            "VERIFICATION_ERROR"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "verification_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verification Error"
        }
      },
      "required": [
        "claim_id",
        "verdict",
        "reason"
      ],
      "title": "SemanticVerdict",
      "type": "object"
    },
    "Slot": {
      "properties": {
        "focus": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Focus"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "Slot",
      "type": "object"
    },
    "SupportingSpan": {
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "quote": {
          "minLength": 8,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "quote"
      ],
      "title": "SupportingSpan",
      "type": "object"
    },
    "VerificationPass": {
      "properties": {
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "support_option_ids": {
          "items": {
            "type": "string"
          },
          "title": "Support Option Ids",
          "type": "array"
        },
        "verdict": {
          "enum": [
            "SUPPORTED",
            "CONTRADICTED",
            "INSUFFICIENT_EVIDENCE",
            "AMBIGUOUS",
            "VERIFICATION_ERROR"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "verdict",
        "reason"
      ],
      "title": "VerificationPass",
      "type": "object"
    }
  },
  "items": {
    "$ref": "#/$defs/AcceptedRecord"
  },
  "type": "array"
}
