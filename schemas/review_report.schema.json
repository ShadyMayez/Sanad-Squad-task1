          "type": "integer"
        },
        "claim_support": {
          "items": {
            "$ref": "#/$defs/ClaimSupport"
          },
          "title": "Claim Support",
          "type": "array"
        },
        "clarity": {
          "maximum": 5,
          "minimum": 0,
          "title": "Clarity",
          "type": "integer"
        },
        "corrections": {
          "items": {
            "type": "string"
          },
          "title": "Corrections",
          "type": "array"
        },
        "factual_support": {
          "maximum": 5,
          "minimum": 0,
          "title": "Factual Support",
          "type": "integer"
        },
        "grounding_assessment": {
          "title": "Grounding Assessment",
          "type": "string"
        },
        "platform_format": {
          "maximum": 5,
          "minimum": 0,
          "title": "Platform Format",
          "type": "integer"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "technical_correctness": {
          "maximum": 5,
          "minimum": 0,
          "title": "Technical Correctness",
          "type": "integer"
        },
        "usefulness": {
          "maximum": 5,
          "minimum": 0,
          "title": "Usefulness",
          "type": "integer"
        }
