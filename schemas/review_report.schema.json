    "ClaimSupport": {
      "properties": {
        "claim_text": {
          "title": "Claim Text",
          "type": "string"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_quote": {
          "title": "Evidence Quote",
          "type": "string"
        },
        "supported": {
          "title": "Supported",
          "type": "boolean"
        }
      },
      "required": [
        "claim_text",
        "evidence_id",
        "evidence_quote",
        "supported"
      ],
      "title": "ClaimSupport",
      "type": "object"
    },
    "Review": {
      "properties": {
        "approved": {
          "title": "Approved",
          "type": "boolean"
        },
        "brand_voice": {
