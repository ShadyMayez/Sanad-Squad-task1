{
  "$defs": {
    "EvidenceContext": {
      "properties": {
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "snapshot_sha256": {
          "title": "Snapshot Sha256",
          "type": "string"
        },
        "source_scope": {
          "default": "",
          "title": "Source Scope",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "text": {
          "minLength": 8,
          "title": "Text",
          "type": "string"
        },
        "token_budget_upper_bound": {
          "default": 1400,
          "exclusiveMinimum": 0,
          "title": "Token Budget Upper Bound",
          "type": "integer"
        },
        "token_upper_bound": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Upper Bound"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        },
        "window_partial": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window Partial"
        }
      },
      "required": [
        "evidence_id",
        "snapshot_sha256",
        "start",
        "end",
        "text"
      ],
      "title": "EvidenceContext",
      "type": "object"
    },
    "SemanticRecord": {
      "properties": {
        "attempts": {
          "items": {
            "$ref": "#/$defs/SemanticReport"
          },
          "title": "Attempts",
          "type": "array"
        },
        "latencies_seconds": {
          "items": {
            "type": "number"
          },
          "title": "Latencies Seconds",
          "type": "array"
        },
        "slot_id": {
          "title": "Slot Id",
          "type": "string"
        }
      },
      "required": [
        "slot_id",
        "attempts",
        "latencies_seconds"
      ],
      "title": "SemanticRecord",
      "type": "object"
    },
    "SemanticReport": {
      "properties": {
        "verdicts": {
          "items": {
            "$ref": "#/$defs/SemanticVerdict"
          },
          "title": "Verdicts",
          "type": "array"
        }
      },
      "required": [
        "verdicts"
      ],
      "title": "SemanticReport",
      "type": "object"
    },
    "SemanticVerdict": {
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "context_windows": {
          "items": {
            "$ref": "#/$defs/EvidenceContext"
          },
          "title": "Context Windows",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "initial_pass": {
          "anyOf": [
            {
              "$ref": "#/$defs/VerificationPass"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "missing_information": {
          "default": "",
          "title": "Missing Information",
          "type": "string"
        },
        "proposed_supporting_spans": {
          "items": {
            "$ref": "#/$defs/SupportingSpan"
          },
          "title": "Proposed Supporting Spans",
          "type": "array"
        },
        "reason": {
          "minLength": 8,
          "title": "Reason",
          "type": "string"
        },
        "scope_mismatch": {
          "default": "",
          "title": "Scope Mismatch",
          "type": "string"
        },
        "skeptical_pass": {
          "anyOf": [
            {
              "$ref": "#/$defs/VerificationPass"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "supporting_span_ids": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Span Ids",
          "type": "array"
        },
        "supporting_spans": {
          "items": {
            "$ref": "#/$defs/SupportingSpan"
          },
          "title": "Supporting Spans",
          "type": "array"
        },
        "verdict": {
          "enum": [
            "SUPPORTED",
            "CONTRADICTED",
            "INSUFFICIENT_EVIDENCE",
            "AMBIGUOUS",
            "VERIFICATION_ERROR"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "verification_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verification Error"
        }
      },
      "required": [
        "claim_id",
        "verdict",
        "reason"
      ],
      "title": "SemanticVerdict",
      "type": "object"
    },
    "SupportingSpan": {
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "quote": {
          "minLength": 8,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "quote"
      ],
      "title": "SupportingSpan",
      "type": "object"
    },
    "VerificationPass": {
      "properties": {
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "support_option_ids": {
          "items": {
            "type": "string"
          },
          "title": "Support Option Ids",
          "type": "array"
        },
        "verdict": {
          "enum": [
            "SUPPORTED",
            "CONTRADICTED",
            "INSUFFICIENT_EVIDENCE",
            "AMBIGUOUS",
            "VERIFICATION_ERROR"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "verdict",
        "reason"
      ],
      "title": "VerificationPass",
      "type": "object"
    }
  },
  "items": {
    "$ref": "#/$defs/SemanticRecord"
  },
  "type": "array"
}
